{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "trading_mode": "spot",
    "max_open_trades": 5,
    "stake_currency": "USDT",
    "stake_amount": 100,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "dry_run_wallet": 10000,
    "timeframe": "5m",
    "cancel_open_orders_on_exit": true,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 30
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "timeout": 60000,
            "enableRateLimit": true,
            "options": {
                "adjustForTimeDifference": true
            }
        },
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT",
            "SOL/USDT",
            "XRP/USDT",
            "ADA/USDT",
            "AVAX/USDT",
            "LINK/USDT",
            "DOT/USDT",
            "LTC/USDT",
            "UNI/USDT",
            "ATOM/USDT",
            "NEAR/USDT",
            "FIL/USDT",
            "HBAR/USDT",
            "SUI/USDT",
            "DOGE/USDT",
            "SHIB/USDT"
        ]
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "freqai": {
        "enabled": true,
        "purge_old_models": 3,
        "train_period_days": 30,
        "backtest_period_days": 7,
        "live_retrain_hours": 24,
        "identifier": "rl_strategy_optimized_v1",
        "continual_learning": true,
        "feature_parameters": {
            "include_timeframes": [
                "5m",
                "15m",
                "1h"
            ],
            "include_corr_pairlist": [
                "BTC/USDT",
                "ETH/USDT"
            ],
            "label_period_candles": 24,
            "include_shifted_candles": 2,
            "weight_factor": 0.9,
            "principal_component_analysis": false,
            "indicator_periods_candles": [10, 20, 50],
            "plot_feature_importances": 0,
            "noise_standard_deviation": 0.05,
            "randomize_starting_position": true
        },
        "data_split_parameters": {
            "test_size": 0.25,
            "random_state": 42
        },
        "rl_config": {
            "train_cycles": 25,
            "cpu_count": 4,
            "max_training_drawdown_pct": 0.05,
            "model_type": "PPO",
            "policy_type": "MlpPolicy",
            "max_trade_duration_candles": 300,
            "model_reward_parameters": {
                "rr": 1,
                "profit_aim": 0.02,
                "win_reward_factor": 2
            }
        },
        "model_training_parameters": {
            "learning_rate": 0.00025,
            "gamma": 0.9,
            "verbose": 1
        }
    },
    "bot_name": "FreqAI_RL_Backtest_Bot",
    "force_entry_enable": true,
    "initial_state": "running",
    "stoploss": -0.05,
    "internals": {
        "process_throttle_secs": 5
    },
    "telegram": {
        "enabled": false,
        "token": "placeholder_token",
        "chat_id": "placeholder_chat_id"
    },
    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "username": "freqtrader",
        "password": "password123"
    }
} 