{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "trading_mode": "spot",
    "max_open_trades": 5,
    "stake_currency": "USDT",
    "stake_amount": 100,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "dry_run_wallet": 10000,
    "timeframe": "5m",
    "cancel_open_orders_on_exit": true,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 30
    },
    "exchange": {
        "name": "binance",
        "key": "eCNYVrwiRPpJTdHuAIJmLsr3M5fASQzaFklbPH9EfpqvFd20ndcUnpQZLof3FXPB",
        "secret": "xblJLEPVldkbINH0nzeWhcqstRMwOKRqFi87l1ZaLNIvOT0yhHGC459my2bIDVuk",
        "ccxt_config": {
            "timeout": 60000,
            "enableRateLimit": true,
            "options": {
                "adjustForTimeDifference": true
            }
        },
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT",
            "SOL/USDT",
            "XRP/USDT",
            "ADA/USDT",
            "AVAX/USDT",
            "LINK/USDT",
            "DOT/USDT",
            "LTC/USDT",
            "UNI/USDT",
            "ATOM/USDT",
            "NEAR/USDT",
            "FIL/USDT",
            "HBAR/USDT",
            "SUI/USDT",
            "DOGE/USDT",
            "SHIB/USDT"
        ],
        "pair_blacklist": [
            "BNB/USDT",
            "LUNA/USDT",
            "UST/USDT",
            "FTT/USDT",
            "TRX/USDT",
            "BCH/USDT",
            "BSV/USDT",
            "ETC/USDT",
            "XMR/USDT",
            "ZEC/USDT",
            "DASH/USDT",
            ".*UP/USDT",
            ".*DOWN/USDT",
            ".*BEAR/USDT",
            ".*BULL/USDT"
        ]
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "pairlists": [
        {
            "method": "StaticPairList",
            "pairs": [
                "BTC/USDT",
                "ETH/USDT",
                "SOL/USDT",
                "XRP/USDT",
                "ADA/USDT",
                "AVAX/USDT",
                "LINK/USDT",
                "DOT/USDT",
                "LTC/USDT",
                "UNI/USDT",
                "ATOM/USDT",
                "NEAR/USDT",
                "FIL/USDT",
                "HBAR/USDT",
                "SUI/USDT",
                "DOGE/USDT",
                "SHIB/USDT"
            ]
        },
        {
            "method": "VolumePairList",
            "number_assets": 20,
            "sort_key": "quoteVolume",
            "min_value": 10000000,
            "refresh_period": 1800
        },
        {
            "method": "AgeFilter",
            "min_days_listed": 30
        },
        {
            "method": "PrecisionFilter"
        },
        {
            "method": "PriceFilter",
            "low_price_ratio": 0.001,
            "min_price": 0.00001,
            "max_price": 10000000
        },
        {
            "method": "SpreadFilter",
            "max_spread_ratio": 0.005
        },
        {
            "method": "RangeStabilityFilter",
            "lookback_days": 10,
            "min_rate_of_change": 0.01,
            "max_rate_of_change": 0.99
        },
        {
            "method": "VolatilityFilter",
            "lookback_days": 10,
            "min_volatility": 0.01,
            "max_volatility": 0.75
        }
    ],
    "freqai": {
        "enabled": true,
        "purge_old_models": 3,
        "train_period_days": 30,
        "backtest_period_days": 7,
        "live_retrain_hours": 24,
        "identifier": "rl_strategy_optimized_v1",
        "continual_learning": true,
        "feature_parameters": {
            "include_timeframes": [
                "5m",
                "15m",
                "1h"
            ],
            "include_corr_pairlist": [
                "BTC/USDT",
                "ETH/USDT"
            ],
            "label_period_candles": 24,
            "include_shifted_candles": 2,
            "weight_factor": 0.9,
            "principal_component_analysis": false,
            "indicator_periods_candles": [10, 20, 50],
            "plot_feature_importances": 0,
            "noise_standard_deviation": 0.05,
            "randomize_starting_position": true
        },
        "data_split_parameters": {
            "test_size": 0.25,
            "random_state": 42
        },
        "rl_config": {
            "train_cycles": 25,
            "cpu_count": 4,
            "max_training_drawdown_pct": 0.05,
            "model_type": "PPO",
            "policy_type": "MlpPolicy",
            "max_trade_duration_candles": 300,
            "model_reward_parameters": {
                "rr": 1,
                "profit_aim": 0.02,
                "win_reward_factor": 2
            }
        },
        "model_training_parameters": {
            "learning_rate": 0.00025,
            "gamma": 0.9,
            "verbose": 1
        }
    },
    "bot_name": "FreqAI_RL_Optimized_Bot",
    "force_entry_enable": true,
    "initial_state": "running",
    "stoploss": -0.05,
    "internals": {
        "process_throttle_secs": 5
    },
    "telegram": {
        "enabled": false,
        "token": "placeholder_token",
        "chat_id": "placeholder_chat_id"
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "verbosity": "error",
        "jwt_secret_key": "your_secret_key_change_this",
        "CORS_origins": [],
        "username": "freqtrader",
        "password": "password123"
    }
} 