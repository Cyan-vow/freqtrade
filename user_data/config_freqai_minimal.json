{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "trading_mode": "spot",
    "max_open_trades": 2,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "stake_amount_unlimited_max": 500,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "dry_run_wallet": 10000,
    "timeframe": "5m",
    "cancel_open_orders_on_exit": true,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 30,
        "exit_timeout_count": 3,
        "unit": "minutes"
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "SOL/USDT",
            "XRP/USDT",
            "ADA/USDT"
        ],
        "pair_blacklist": []
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": false,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": false,
        "order_book_top": 1
    },
    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "force_exit": "market",
        "force_entry": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false
    },
    "order_time_in_force": {
        "entry": "GTC",
        "exit": "GTC"
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "freqai": {
        "enabled": true,
        "purge_old_models": 1,
        "train_period_days": 10,
        "backtest_period_days": 5,
        "live_retrain_hours": 24,
        "identifier": "rl_minimal_v1",
        "continual_learning": false,
        "write_metrics_to_disk": true,
        "data_kitchen_thread_count": 1,
        "feature_parameters": {
            "include_timeframes": [
                "5m"
            ],
            "include_corr_pairlist": [
                "SOL/USDT"
            ],
            "label_period_candles": 12,
            "include_shifted_candles": 1,
            "DI_threshold": 0.9,
            "weight_factor": 0.9,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": false,
            "indicator_periods_candles": [
                10
            ],
            "plot_feature_importances": 0,
            "noise_standard_deviation": 0.0,
            "randomize_starting_position": false,
            "buffer_train_data_candles": 0
        },
        "data_split_parameters": {
            "test_size": 0.33,
            "shuffle": false,
            "random_state": 42
        },
        "model_training_parameters": {
            "learning_rate": 0.0003,
            "gamma": 0.99,
            "verbose": 1
        },
        "rl_config": {
            "train_cycles": 5,
            "cpu_count": 1,
            "max_training_drawdown_pct": 0.1,
            "model_type": "PPO",
            "policy_type": "MlpPolicy",
            "policy_kwargs": {
                "net_arch": [32, 32]
            },
            "max_trade_duration_candles": 200,
            "model_reward_parameters": {
                "rr": 1.0,
                "profit_aim": 0.01,
                "win_reward_factor": 1.0
            },
            "add_state_info": true,
            "net_arch": [32, 32],
            "randomize_startinng_position": false,
            "model_save_type": "stable_baselines3"
        }
    },
    "bot_name": "FreqAI_Minimal_Bot",
    "force_entry_enable": false,
    "initial_state": "running",
    "internals": {
        "process_throttle_secs": 5,
        "heartbeat_interval": 60
    },
    "telegram": {
        "enabled": false,
        "token": "placeholder_token",
        "chat_id": "placeholder_chat_id"
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8082,
        "verbosity": "error",
        "enable_openapi": true,
        "jwt_secret_key": "minimal_test_key",
        "CORS_origins": [],
        "username": "freqtrader",
        "password": "test123"
    },
    "db_url": "sqlite:///tradesv3_minimal.sqlite",
    "user_data_dir": "user_data",
    "strategy": "FreqAIRLStrategy",
    "strategy_path": "user_data/strategies/",
    "freqaimodel": "RLModel",
    "freqaimodel_path": "user_data/freqaimodels/",
    "dataformat_ohlcv": "feather",
    "dataformat_trades": "feather"
} 